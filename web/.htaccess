AddType application/x-httpd-php .aspx
IndexIgnore *

# Request dumps and snapshot logs contain auth tokens and raw stats data
<FilesMatch "\.(txt|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Debug tool that can mint auth tokens for any player
<Files "sample.php">
    <IfModule mod_authz_core.c>
        Require local
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
        Allow from 127.0.0.1 ::1
    </IfModule>
</Files>
