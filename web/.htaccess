AddType application/x-httpd-php .aspx
IndexIgnore *

# Request dumps and snapshot logs contain auth tokens and raw stats data
<FilesMatch "\.(txt|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
