# Copy to .env and edit before running `docker compose up`.

# Database name and the account the web server and Fesl login server use
DB_NAME=bf2142
DB_USER=bf2142
DB_PASS=change-me
DB_ROOT_PASS=change-me-too

# Game servers allowed to submit round stats: comma-separated IPs or
# x.x.x.x/nn subnets. Only applied when the database is first created; add
# more later with an INSERT into the `servers` table.
AUTHORISED_SERVERS=

# Save every game request and round snapshot for debugging (0 or 1). The
# logs contain players' auth tokens; they go to the web-debug-logs volume.
LOG_REQUESTS=0

# Web admin (/admin.php). Login is disabled while ADMIN_USER or ADMIN_PASS is
# empty. ADMIN_HOSTS lists the IPs or x.x.x.x/nn subnets allowed to open it;
# requests from your browser reach the container from Docker's network, so
# on Linux 172.16.0.0/12 lets in this machine.
ADMIN_USER=
ADMIN_PASS=
ADMIN_HOSTS=

# Host ports
WEB_PORT=80
DB_PORT=3306
